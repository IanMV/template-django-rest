FROM python:3.14-slim
ENV PATH="/opt/venv/bin:${PATH}" \
    PDM_CHECK_UPDATE=false \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=app.settings.dev
WORKDIR /app
RUN python -m venv /opt/venv && pip install --no-cache-dir "pdm>=2.26,<3"
COPY pyproject.toml pdm.lock ./
RUN pdm use -f /opt/venv/bin/python && pdm sync -G dev
COPY . ./
RUN useradd --uid 1000 --create-home developer && chown -R developer:developer /app
USER developer
EXPOSE 8000
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
