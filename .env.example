SECRET_KEY= # Chave exclusiva, mínimo de 50 caracteres, sem prefixo django-insecure-
ALLOWED_HOSTS=  # Hosts da API separados por vírgula; não aceita lista vazia ou *
FRONTEND_ORIGINS=   # Origens HTTPS separadas por vírgula, sem caminhos ou barra final; configura CORS e CSRF
DATABASE_URL=   #URL PostgreSQL com host e nome do banco
EMAIL_HOST=	    # Host do servidor SMTP
DEFAULT_FROM_EMAIL=	    # Remetente dos e-mails

EMAIL_HOST_USER=	# Necessária se o SMTP exigir autenticação
EMAIL_HOST_PASSWORD=django.core.mail.backends.smtp.EmailBackend	# Necessária se o SMTP exigir autenticação
EMAIL_PORT=587	# Porta SMTP
EMAIL_USE_TLS=true	# # Ativa STARTTLS: a conexão SMTP passa a usar TLS após a negociação inicial
EMAIL_USE_SSL=false	# TLS implícito; não habilitar junto com STARTTLS
TRUST_PROXY_HEADERS=false	# Ativar somente com proxy confiável
NUM_PROXIES=0	# Quantidade de proxies; inteiro não negativo

POSTGRES_DB=template_auth   # Nome do banco criado pelo contêiner PostgreSQL na inicialização
POSTGRES_PASSWORD=  # Senha administrativa do PostgreSQL
APP_DB_PASSWORD=    # Senha do usuário da aplicação
APP_DB_USER=    # Senha desse usuário; Deve corresponder à informada na DATABASE_URL
WEB_CONCURRENCY=2   # Quantidade de processos workers do Gunicorn
IMAGE_TAG=local # Tag da imagem da aplicação usada pelo Compose
HTTP_BIND=0.0.0.0   # Interface do host que publica a porta HTTP
HTTP_PORT=80    # Porta HTTP publicada no host
HTTPS_BIND=0.0.0.0  # Interface do host que publica a porta HTTPS
HTTPS_PORT=443  # Porta HTTPS publicada no host
TLS_DIR=./deploy/tls    # Diretório no host contendo fullchain.pem e privkey.pem

TRUST_PROXY_HEADERS=true    # A stack incluída usa Nginx como proxy confiável
NUM_PROXIES=1   # A topologia padrão tem um proxy: Nginx

LOCAL_UID=1000  # UID do usuário que executa o contêiner de desenvolvimento
LOCAL_GID=1000  # GID do grupo que executa o contêiner de desenvolvimento
APP_PORT=19003   # Porta local publicada para o servidor Django

DJANGO_SETTINGS_MODULE=app.settings.prod    # Para comandos administrativos de produção, ou use `--settings=app.settings.prod`




