# Replace all placeholders before use. Do not commit the resulting .env.
POSTGRES_DB=template_auth
POSTGRES_USER=template_auth
POSTGRES_PASSWORD=replace-with-a-strong-password

SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
APP_PORT=8000
SECURE_SSL_REDIRECT=false
NUM_PROXIES=0

# Compose has no SMTP service. Console mail is suitable only for local container checks.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com

# Leave empty to retain audit records. Set a positive integer only after retention is approved.
AUDIT_RETENTION_DAYS=
