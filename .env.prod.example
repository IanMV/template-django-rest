# Required secrets and deployment addresses must be supplied before startup.
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=template_auth
POSTGRES_PASSWORD=
APP_DB_USER=template_auth
APP_DB_PASSWORD=
DATABASE_URL=
REDIS_PASSWORD=
REDIS_URL=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=

# Direct Nginx: 1; Cloudflare -> Nginx or ALB -> Nginx: 2.
NUM_PROXIES=1
NGINX_CONFIG=direct.conf
TLS_DIR=./deploy/tls
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2
REDIS_MAXMEMORY=256mb
IMAGE_TAG=local

# Empty disables deletion; define a positive legal retention period when approved.
AUDIT_RETENTION_DAYS=
